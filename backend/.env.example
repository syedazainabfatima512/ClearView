# Environment Variables for ClearView Backend
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
# For local: mongodb://localhost:27017/clearview
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/clearview
MONGODB_URI=mongodb://localhost:27017/clearview

# JWT Authentication Secret
# Generate a strong random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# NVIDIA-hosted LLM Configuration
# Use a rotated key instead of any key previously pasted in chat or source history.
LLM_API_KEY=your-nvidia-api-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=minimaxai/minimax-m2.7
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=25000
LLM_MAX_RETRIES=0
LLM_RESUME_MAX_TOKENS=1400
LLM_QUESTION_MAX_TOKENS=2500
LLM_ANSWER_MAX_TOKENS=900
LLM_BATCH_MAX_TOKENS=3500
LLM_SUMMARY_MAX_TOKENS=1200

# CORS Allowed Origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
